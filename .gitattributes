# Normalise line endings so a Windows contributor and a Linux CI runner do not
# produce diffs that are entirely invisible in a review.
* text=auto eol=lf

*.py   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.txt  text eol=lf

# Binary assets must never be line-ending converted; doing so corrupts a font.
*.ttf binary
*.otf binary
*.ttc binary
*.png binary
*.jpg binary
*.pdf binary
